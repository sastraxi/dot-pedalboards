_:b1
    ingen:tail <CollisionDrive/out> ;
    ingen:head <neural_amp_modeler_lv2/input> .

_:b2
    ingen:tail <a_reverb/out1> ;
    ingen:head <stereo/inR> .

_:b3
    ingen:tail <Eq10/out> ;
    ingen:head <cab_ir/lv2_audio_in> .

_:b4
    ingen:tail <neural_amp_modeler_lv2/output> ;
    ingen:head <Eq10/in> .

_:b5
    ingen:tail <cab_ir/lv2_audio_out> ;
    ingen:head <a_reverb/in0> .

_:b6
    ingen:tail <capture_1> ;
    ingen:head <CollisionDrive/in> .

_:b7
    ingen:tail <cab_ir/lv2_audio_out> ;
    ingen:head <a_reverb/in1> .

_:b8
    ingen:tail <cab_ir/out> ;
    ingen:head <a_reverb/in0> .

_:b9
    ingen:tail <Eq10/out> ;
    ingen:head <cab_ir/in> .

_:b10
    ingen:tail <stereo/outR> ;
    ingen:head <playback_2> .

_:b11
    ingen:tail <cab_ir/out> ;
    ingen:head <a_reverb/in1> .

<CollisionDrive>
    ingen:canvasX 145.0 ;
    ingen:canvasY 210.0 ;
    ingen:enabled true ;
    ingen:polyphonic false ;
    lv2:microVersion 3 ;
    lv2:minorVersion 1 ;
    mod:builderVersion 0 ;
    mod:releaseNumber 0 ;
    lv2:port <CollisionDrive/in> ,
             <CollisionDrive/out> ,
             <CollisionDrive/BYPASS> ,
             <CollisionDrive/BRIGHT> ,
             <CollisionDrive/GATE> ,
             <CollisionDrive/ATTACK> ,
             <CollisionDrive/DRIVE> ,
             <CollisionDrive/LEVEL> ,
             <CollisionDrive/V1> ,
             <CollisionDrive/:bypass> ;
    lv2:prototype <https://github.com/brummer10/CollisionDrive> ;
    pedal:instanceNumber 6 ;
    pedal:preset <> ;
    a ingen:Block .

<CollisionDrive/in>
    a lv2:AudioPort ,
        lv2:InputPort .

<CollisionDrive/in>
    a lv2:AudioPort ,
        lv2:OutputPort .

<CollisionDrive/BYPASS>
    ingen:value 1.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/BRIGHT>
    ingen:value 0.500000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/GATE>
    ingen:value -55.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/ATTACK>
    ingen:value 3.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/DRIVE>
    ingen:value 0.100000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/LEVEL>
    ingen:value -10.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<CollisionDrive/V1>
    a lv2:ControlPort ,
        lv2:OutputPort .

<CollisionDrive/:bypass>
    ingen:value 0 ;
    a lv2:ControlPort ,
        lv2:InputPort .

