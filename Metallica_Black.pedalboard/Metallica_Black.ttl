<>
    doap:name "Metallica Black" ;
    pedal:unitName "Unknown" ;
    pedal:unitModel "None" ;
    pedal:width 2908 ;
    pedal:height 1368 ;
    pedal:addressings <addressings.json> ;
    pedal:screenshot <screenshot.png> ;
    pedal:thumbnail <thumbnail.png> ;
    pedal:version 15 ;
    ingen:polyphony 1 ;
    ingen:arc _:b1 ,
              _:b2 ,
              _:b3 ,
              _:b4 ,
              _:b5 ,
              _:b6 ,
              _:b7 ,
              _:b8 ,
              _:b9 ,
              _:b10 ,
              _:b11 ;
    ingen:block <CollisionDrive> ,
                <Eq10> ,
                <a_reverb> ,
                <cab_ir> ,
                <neural_amp_modeler_lv2> ,
                <stereo> ;
    lv2:port <:bpb> ,
             <:bpm> ,
             <:rolling> ,
             <midi_separated_mode> ,
             <midi_loopback> ,
             <control_in> ,
             <control_out> ,
